{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "framework": null,
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/copy-of-window-solutions",
      "destination": "/stainless-steel-benches",
      "permanent": true
    },
    {
      "source": "/copy-of-window-solutions/",
      "destination": "/stainless-steel-benches",
      "permanent": true
    }
  ]
}
